  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_atr_pilotage`
  OPTIONS()
  as WITH  prep_data AS (

SELECT
id_benef,
nom,
ide,
agence,
conseiller,
referent,
id_ref_principal,
date_demarrage,
date_fin_theo,
date_fin_prest,
numero_commande,
split(lot, ' ')[safe_offset(0)] as marche,
split(lot, ' ')[safe_offset(1)] as region,
split(lot, ' ')[safe_offset(2)] as lot_unique,
trim(substr(lot, strpos(lot, ' ') + 1)) as lot_sans_action,
site,
id_site,
organisme,
statut,
situation,
id_presta_coll,
CASE 
    WHEN statut IN("Demande sans suite","Ne s'est pas présenté") THEN 0
    ELSE 1
END AS activite
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_benef`
),


jointure AS 

(SELECT 
pd.*,
r.date_deb,
r.date_fin,
r.type,
r.objet,
r.present,
r.motif_absence,
r.theme,
r.module,
r.commentaire,
TIMESTAMP_DIFF(CAST(r.date_fin AS TIMESTAMP),CAST(r.date_deb AS TIMESTAMP),HOUR) AS duree_seance
FROM prep_data as pd 
LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_rdv` as r
ON pd.id_benef = r.id_benef
WHERE marche ="ATR"

),

KPI AS (SELECT 
*,
CASE WHEN statut NOT IN ("Annulé") THEN 1 
    ELSE 0
    END AS oriente,
CASE WHEN statut IN ("n'a pas adhéré","Prestation aboutie","Prestation en cours","Sortie anticipée") THEN 1
    ELSE 0
END AS recu,
    CASE 
        WHEN activite = 1 AND statut IN ("Prestation aboutie", "Sortie anticipée", "Prestation en cours") THEN 1
        ELSE 0
    END AS adhesion,

FROM jointure

),

creation_rang AS (
    SELECT
*,
CASE
    WHEN duree_seance > 3 AND recu = 1  THEN "longue"
    WHEN duree_seance <=3 AND recu = 1 THEN "courte"
    ELSE ""
END AS type_atelier,
CASE 
    WHEN statut = "Annulé" THEN 1
    ELSE 0
END AS session_annulee,
CASE 
    WHEN statut = "Annulé" THEN "Annulé"
    ELSE "Réalisé"
END AS type_session,
EXTRACT(MONTH FROM CAST(date_deb AS TIMESTAMP)) AS mois_num,
ROW_NUMBER() OVER (
            PARTITION BY numero_commande
            ORDER BY date_deb ASC
        ) AS rang_entree,
FROM KPI

),

jointure_facture AS (
    SELECT
    c.*,
    f.date_facture,
    CASE
        WHEN rang_entree = 1 THEN f.montant_HT
        ELSE 0
    END AS ca_atelier
    FROM creation_rang AS c
    LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_facture` AS f
    ON c.id_presta_coll = f.id_presta_coll
    QUALIFY ROW_NUMBER() OVER (PARTITION BY c.id_benef, c.numero_commande ORDER BY f.date_facture DESC) = 1
)

--final AS (

SELECT
*,
MAX(ca_atelier) OVER (PARTITION BY numero_commande) / NULLIF(MAX(rang_entree) OVER (PARTITION BY numero_commande), 0) AS ca_atelier_par_benef,
CASE
    WHEN numero_commande <> ""
    AND rang_entree = MIN(CASE WHEN type_atelier IN ("longue","courte") OR ca_atelier > 0 THEN rang_entree ELSE NULL END) OVER (PARTITION BY numero_commande)
    AND (type_atelier IN ("longue","courte") OR ca_atelier > 0) THEN 1
    ELSE 0
END AS nb_atelier_real
FROM jointure_facture




--SELECT
--DISTINCT(numero_commande)
--DISTINCT (region) AS region,

--COUNT(DISTINCT CASE WHEN nb_atelier_real = 1 THEN numero_commande ELSE NULL END),
--SUM (nb_atelier_real)
--FORMAT_TIMESTAMP('%Y-%m', CAST(date_deb AS TIMESTAMP)) AS date_date
--FROM final
--WHERE organisme = "ENVERGURE" AND FORMAT_TIMESTAMP('%Y-%m', CAST(date_deb AS TIMESTAMP)) = "2026-03" AND region = "NOR" AND numero_commande IN ("SKATRE1008","SKATRE1036","SKATRE0980","SKATRE1006","SKATRE1093","SKATRE0868","SKATRE1216","SKATRE1031","SKATRE0970","SKATRE0863");


