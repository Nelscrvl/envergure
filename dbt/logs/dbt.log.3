  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_ca_global`
  OPTIONS()
  as SELECT
f.*,
EXTRACT(MONTH FROM CAST(f.date_facture AS TIMESTAMP)) AS mois_num,
CAST(FORMAT_DATE('%Y%m', f.date_facture) AS INT64) AS annee_mois_sort,
p.Montant_prime,
p.Date_primes
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`int_formateur_Ca` as f
LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`int_pilotage_prime` as p
ON f.id_benef = p.id_benef
WHERE montant_HT >0;


