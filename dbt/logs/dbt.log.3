  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_atr_test`
  OPTIONS()
  as WITH  prep_data AS (

SELECT
id_benef,
nom,
ide,
agence,
conseiller,
referent,
id_ref_principal,
date_demarrage,
date_fin_theo,
date_fin_prest,
split(lot, ' ')[safe_offset(0)] as marche,
split(lot, ' ')[safe_offset(1)] as region,
split(lot, ' ')[safe_offset(2)] as lot_unique,
trim(substr(lot, strpos(lot, ' ') + 1)) as lot_sans_action,
site,
id_site,
organisme,
statut,
situation,
CASE 
    WHEN statut IN("Demande sans suite","Ne s'est pas présenté") THEN 0
    ELSE 1
END AS activite
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_benef`
),


jointure AS 

(SELECT 
pd.*,
r.date_deb,
r.date_fin,
r.type,
r.objet,
r.present,
r.motif_absence,
r.theme,
r.module,
r.commentaire
FROM prep_data as pd 
LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_rdv` as r
ON pd.id_benef = r.id_benef
WHERE marche ="ATR"

)

SELECT 
*,
CASE WHEN statut NOT IN ("Annulé", "Ne s'est pas présenté") THEN 1 
    ELSE 0
    END AS oriente 
FROM jointure;


