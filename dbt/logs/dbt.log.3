  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_benef_ca_prime`
  OPTIONS()
  as WITH ca AS (
    SELECT
        id_benef,
        referent,
        date_demarrage,
        date_fin_prest,
        marche,
        lot_unique, 
        organisme,
        statut,
        situation,
        site,
