  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_BDD_BU`
  OPTIONS()
  as WITH UNION_TABLE AS (
SELECT

*EXCEPT(VALEUR),
CASE WHEN TYPE = "REALISE" OR TYPE = "BUDGET" THEN 0
    ELSE VALEUR
END AS VALEUR


FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_DAF_BDD_BU_NATIVE`

UNION ALL 

SELECT

*

FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_DAF_BDD_EDM_NATIVE`
)

SELECT 
*,
CASE WHEN ANNEE = "2025" THEN FORMAT_DATE('%Y-%m', DATE_ADD(PARSE_DATE('%Y-%m-%d', CONCAT(FORMAT('%04d-%02d', CAST(ANNEE AS INT64), CAST(MOIS AS INT64)), '-01')), INTERVAL 1 YEAR)) 
ELSE ""
END AS periode_n1,
CASE WHEN CODE_BU LIKE "B%" THEN 1 
ELSE 0 
END AS CAT_BU_LIBELLE
FROM UNION_TABLE;


