    create or replace table `dynamic-camp-465312-b6`.`dbt_transfo`.`int_rdv_formateur`
      
    
    

    OPTIONS()
    as (
      WITH jointure AS (
    SELECT 
rdv.id_benef,
id_rdv,
date_deb,
date_fin,
type,
typage,
objet,
statut,
rdv.referent,
rdv.id_referent,
