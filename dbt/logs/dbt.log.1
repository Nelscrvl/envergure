WITH src AS (
  SELECT
    temps_action_id AS codification_action,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_01, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_01,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_02, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_02,
