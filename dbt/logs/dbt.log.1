),

granularite AS (
SELECT 
*,
CASE 
    WHEN presence = "present"  THEN TIMESTAMP_DIFF(
             TIMESTAMP(date_fin),
             TIMESTAMP(date_deb),
             MINUTE
           )
    ELSE 0
END AS tps_travail_ref
FROM jointure
)


