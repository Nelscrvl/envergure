        stg.Adresse.Ville as stg_ville,
        stg.Adresse.Arrondissement as stg_arrondissement,
        stg.Adresse.Pays as stg_pays
        
    FROM source,
    UNNEST([source.formateur_referent]) as fr,
    UNNEST([source.stagiaire]) as stg
    

)

