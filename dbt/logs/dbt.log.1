    create or replace table `dynamic-camp-465312-b6`.`2_intermediate`.`ENV_MS_PROD`
      
    
    

    
    OPTIONS()
    as (
      

WITH src AS (
  SELECT
    codis_action AS codification_action,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_01, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_01,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_02, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_02,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_03, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_03,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_04, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_04,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_05, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_05,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_06, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_06,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_07, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_07,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_08, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_08,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_09, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_09,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_10, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_10,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_11, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_11,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ms_2026_12, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ms_2026_12
  FROM `dynamic-camp-465312-b6`.`1_natives`.`CUBA_MS_PROD`
  WHERE codis_action IS NOT NULL
),

ref_actions AS (
  SELECT DISTINCT
    codification_action,
    analytique_bu                                  AS bu,
    COALESCE(NULLIF(UPPER(TRIM(famille_prestation)), ''), 'A')  AS famille
  FROM `dynamic-camp-465312-b6`.`1_natives`.`ENV_REF_ACTIONS`
  WHERE codification_action IS NOT NULL
),

ref_marches AS (
  SELECT DISTINCT
    codification_action,
    analytique_bu AS bu
  FROM `dynamic-camp-465312-b6`.`1_natives`.`ENV_REF_MARCHES`
  WHERE codification_action IS NOT NULL
),

unpiv AS (
  SELECT codification_action, 1 AS mois, ms_2026_01 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 2 AS mois, ms_2026_02 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 3 AS mois, ms_2026_03 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 4 AS mois, ms_2026_04 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 5 AS mois, ms_2026_05 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 6 AS mois, ms_2026_06 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 7 AS mois, ms_2026_07 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 8 AS mois, ms_2026_08 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 9 AS mois, ms_2026_09 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 10 AS mois, ms_2026_10 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 11 AS mois, ms_2026_11 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 12 AS mois, ms_2026_12 AS valeur FROM src
  
),

joined AS (
  SELECT
    u.codification_action,
    COALESCE(a.bu, m.bu)                  AS bu,
    COALESCE(a.famille, 'A')               AS famille,
    u.mois,
    u.valeur
  FROM unpiv u
  LEFT JOIN ref_actions a USING (codification_action)
  LEFT JOIN ref_marches m USING (codification_action)
),

agg AS (
  SELECT codification_action, bu, mois, famille, SUM(valeur) AS valeur  -- MS Prod brute, chargement appliqué côté Sheet
  FROM joined
  GROUP BY codification_action, bu, mois, famille
),

expanded AS (
  SELECT
  a.codification_action,
  a.bu,
  a.mois,
  a.famille,
  rm.code_rubrique,
  a.valeur
FROM agg a
INNER JOIN (
  SELECT 'TOTAL' AS scope, 'C119' AS code_rubrique UNION ALL
  SELECT 'A' AS scope, 'C120' AS code_rubrique UNION ALL
  SELECT 'F' AS scope, 'C121' AS code_rubrique UNION ALL
  SELECT 'P' AS scope, 'C611' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
  OR rm.scope = a.famille
)

SELECT * FROM expanded
WHERE NOT (code_rubrique = 'C119' AND famille = 'D')
  AND valeur IS NOT NULL AND valeur != 0
    );
  
