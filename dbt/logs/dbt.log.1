    create or replace table `dynamic-camp-465312-b6`.`2_intermediate`.`ENV_FDG`
      
    
    

    
    OPTIONS()
    as (
      

WITH src AS (
  SELECT
    codification_action,
    analytique_bu                                  AS bu,
    COALESCE(NULLIF(UPPER(TRIM(famille_prestation)), ''), 'A')  AS famille,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_01, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_janvier,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_02, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_fevrier,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_03, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_mars,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_04, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_avril,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_05, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_mai,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_06, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_juin,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_07, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_juillet,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_08, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_aout,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_09, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_septembre,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_10, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_octobre,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_11, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_novembre,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(mois_12, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg_decembre
  FROM `dynamic-camp-465312-b6`.`1_natives`.`book_2026`
  WHERE codification_action IS NOT NULL
),

unpiv AS (
  SELECT codification_action, bu, famille, 1 AS mois, fdg_janvier AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 2 AS mois, fdg_fevrier AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 3 AS mois, fdg_mars AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 4 AS mois, fdg_avril AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 5 AS mois, fdg_mai AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 6 AS mois, fdg_juin AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 7 AS mois, fdg_juillet AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 8 AS mois, fdg_aout AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 9 AS mois, fdg_septembre AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 10 AS mois, fdg_octobre AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 11 AS mois, fdg_novembre AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 12 AS mois, fdg_decembre AS valeur FROM src
  
),

agg AS (
  SELECT codification_action, bu, mois, famille, SUM(valeur) AS valeur
  FROM unpiv
  GROUP BY codification_action, bu, mois, famille
),

expanded AS (
  SELECT
  a.codification_action,
  a.bu,
  a.mois,
  a.famille,
  rm.code_rubrique,
  a.valeur
FROM agg a
INNER JOIN (
  SELECT 'TOTAL' AS scope, 'C123' AS code_rubrique UNION ALL
  SELECT 'A' AS scope, 'C603' AS code_rubrique UNION ALL
  SELECT 'F' AS scope, 'C604' AS code_rubrique UNION ALL
  SELECT 'P' AS scope, 'C605' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
  OR rm.scope = a.famille
)

SELECT * FROM expanded
WHERE NOT (code_rubrique = 'C123' AND famille = 'D')
  AND valeur IS NOT NULL AND valeur != 0
    );
  
