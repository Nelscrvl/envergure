    create or replace table `dynamic-camp-465312-b6`.`dbt_transfo`.`int_inscrit_pilotage`
      
    
    

    OPTIONS()
    as (
      with inscrits as (
    select * from `dynamic-camp-465312-b6`.`dbt_transfo`.`Int_inscrit_formation`
),

conventions as (
    select * from `dynamic-camp-465312-b6`.`dbt_transfo`.`int_convention_pilotage`
)

select
    -- Identifiants
    i.ID                                                                    as id_inscription,
    i.stg_stagiaire_id,
    i.stg_nom,
    i.stg_prenom,
    i.stg_date_naissance,
    i.IDAction                                                              as id_action,
    i.Code_Analytique_Parcours                                              as code_analytique_parcours,
    i.Libelle_Parcours                                                      as libelle_parcours,
    i.conv_id                                                               as id_convention,
    i.conv_id_societe                                                       as id_societe,
    i.conv_client_nom,
    i.conv_financeur_nom,
    i.conv_numero_interne,
    i.conv_date_rupture,
    i.Date_Entree                                                           as date_entree,
    i.Date_Sortie                                                           as date_sortie,
    i.Date_Sortie_Previsionnelle                                            as date_sortie_previsionnelle,
    i.presence,

    -- Région et formateur référent
    i.Type_Region                                                           as type_region,
    i.Code_Region                                                           as code_region,
    i.fr_nom                                                                as formateur_nom,
    i.fr_prenom                                                             as formateur_prenom,

    -- Dimensions convention (non sommables, pas de risque de double-comptage)
    c.financeur_nom,
    c.etat_convention,
    CAST(c.terminee AS INT64)                                               as terminee,
    c.type_convention,
    c.lieu_formation,

    -- Heures réalisées par inscrit
    i.heures_realisees,
    i.heures_absence,
    i.heures_stage,
    i.heures_realisees + i.heures_stage                                     as heures_totales,

    -- Objectifs heures par inscrit (depuis Type_Tarif.Duree_Stagiaire_* → déjà per-trainee)
    c.duree_stagiaire_centre_bdc                                            as heures_centre_prevues,
    c.duree_stagiaire_entrep_bdc                                            as heures_entrep_prevues,
    COALESCE(c.duree_stagiaire_centre_bdc, 0)
        + COALESCE(c.duree_stagiaire_entrep_bdc, 0)                        as heures_totales_prevues,

    -- Tarif (contexte informatif)
    i.nom_type_tarif,
    i.prix_stagiaire_centre,
    i.prix_stagiaire_entrep,
    i.nb_inscrits_groupe,

    -- Objectif CA par inscrit (montant convention alloué équitablement)
    SAFE_DIVIDE(c.montant_total_bdc, c.nb_inscrits)                        as ca_prevu_par_inscrit,

    -- CA réel généré par cet inscrit (calculé selon le type de tarif dans Int_inscrit_formation)
    i.ca_centre,
    i.ca_entrep,
    i.ca_total                                                              as ca_genere,

    -- KPIs de réalisation
    SAFE_DIVIDE(i.heures_realisees, c.duree_stagiaire_centre_bdc) * 100    as taux_realisation_centre,
    SAFE_DIVIDE(i.heures_stage,     c.duree_stagiaire_entrep_bdc) * 100    as taux_realisation_entrep,
    SAFE_DIVIDE(
        i.heures_realisees + i.heures_stage,
        COALESCE(c.duree_stagiaire_centre_bdc, 0)
            + COALESCE(c.duree_stagiaire_entrep_bdc, 0)
    ) * 100                                                                 as taux_realisation_total,

    -- Flags (0/1)
    IF(i.Date_Sortie < i.Date_Sortie_Previsionnelle, 1, 0)                 as abandon_parcours,
    IF(i.heures_realisees >= c.duree_stagiaire_centre_bdc, 1, 0)           as a_realise_heures_centre,
    IF(i.heures_stage >= COALESCE(c.duree_stagiaire_entrep_bdc, 0), 1, 0) as a_realise_heures_entrep,
    IF(i.ca_total >= SAFE_DIVIDE(c.montant_total_bdc, c.nb_inscrits), 1, 0)   as a_genere_assez_ca

from inscrits i
left join conventions c
    on  c.id_convention = CAST(i.conv_id         AS STRING)
    and c.id_societe    = CAST(i.conv_id_societe  AS STRING)
WHERE heures_realisees >0
    );
  
