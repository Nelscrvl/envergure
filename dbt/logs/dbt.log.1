        source.Convention.Financeur.ID      as conv_financeur_id,
        source.Convention.Financeur.Nom     as conv_financeur_nom

    FROM source,
    UNNEST([source.formateur_referent]) as fr,
    UNNEST([source.stagiaire]) as stg
    

)

