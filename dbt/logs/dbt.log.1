        cast(source.Debut as string) as source_debut,
        IDModule as id_module,
        format_datetime('%Y-%m-%d %H:%M:%S', Date) as date_date,
        source.ID  as source_id,

        -- traçabilité
        'Presence_Soc_2' as source_table

    from source
