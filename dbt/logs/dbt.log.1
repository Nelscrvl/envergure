  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_factu_ca`
  OPTIONS()
  as WITH ajout_info AS (
SELECT
f.*,
pg.marche,
pg.lot_unique,
pg.organisme,
pg.referent,
pg.numero_commande,
pg.lot,
pg.region,
CAST(FORMAT_DATE('%Y%m', f.date_facture) AS INT64) AS annee_mois_factu
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_facture` AS f
LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`int_pilotage_global` AS pg
ON f.id_benef = pg.id_benef
WHERE type_facture ="solde"
)

SELECT
ai.*,
p.Montant_prime,
FROM ajout_info AS ai 
LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_prime_compile` p
  ON ai.numero_commande = p.LC;


