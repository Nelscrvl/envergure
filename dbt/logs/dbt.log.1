        source.Type_apprentissage,
        source.IDParcours_Groupe,  
        format_datetime('%Y-%m-%d %H:%M:%S',source.Date_Sortie_Previsionnelle) AS Date_Sortie_Previsionnelle,
        
        -- Informations du formateur référent (préfixe fr_)
