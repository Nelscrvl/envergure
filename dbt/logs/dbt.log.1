  FROM `dynamic-camp-465312-b6`.`1_natives`.`BEN17_REF_MARCHE`
  WHERE Codif_action_site IS NOT NULL
),

agg AS (
  SELECT
    r.codification_action,
    m.bu,
    r.mois,
    m.famille,
    SUM(r.ss_traitant) AS valeur
  FROM r2026 r
  LEFT JOIN ref_marche m USING (codification_action)
  GROUP BY r.codification_action, m.bu, r.mois, m.famille
),

expanded AS (
  SELECT
  a.codification_action,
  a.bu,
  a.mois,
  a.famille,
  rm.code_rubrique,
  a.valeur
FROM agg a
INNER JOIN (
  SELECT 'TOTAL' AS scope, 'C124' AS code_rubrique UNION ALL
  SELECT 'A' AS scope, 'C125' AS code_rubrique UNION ALL
  SELECT 'F' AS scope, 'C126' AS code_rubrique UNION ALL
  SELECT 'P' AS scope, 'C606' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
  OR rm.scope = a.famille
)

SELECT * FROM expanded
WHERE NOT (code_rubrique = 'C124' AND famille = 'D')
  AND valeur IS NOT NULL AND valeur != 0
    );
  
