  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_inscrite_Soc_3`
  OPTIONS()
  as with source as (
    select * from `dynamic-camp-465312-b6`.`Extract_Sofia`.`Inscrite_Soc_3`
),

renamed as (
    SELECT
        -- Colonnes racines
        source.Code_Analytique_Parcours,
        source.Type_Region,
        source.Code_Region,
        source.Libelle_Court_Parcours,
        source.Libelle_Parcours_Groupe,
