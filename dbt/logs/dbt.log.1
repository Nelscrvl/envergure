  SELECT 'A' AS scope, 'C120' AS code_rubrique UNION ALL
  SELECT 'F' AS scope, 'C121' AS code_rubrique UNION ALL
  SELECT 'P' AS scope, 'C611' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
