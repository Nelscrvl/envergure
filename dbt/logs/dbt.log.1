  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_convention_Soc_2`
  OPTIONS()
  as with source as (
        select * from `dynamic-camp-465312-b6`.`Extract_Sofia`.`Convention_Soc_2`
  ),
  renamed as (
      select
