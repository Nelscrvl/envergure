  WHERE id_presta_coll IS NOT NULL
  GROUP BY id_presta_coll
),

-- Filter + sign montant_HT before the join so int_pilotage_global is scanned only once
factures_base AS (
  SELECT
    * EXCEPT(montant_HT),
    CASE
      WHEN type_facture = 'avoir' THEN -SAFE_CAST(montant_HT AS FLOAT64)
      ELSE                              SAFE_CAST(montant_HT AS FLOAT64)
    END AS montant_HT
  FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_facture`
  WHERE (type_facture = 'solde' AND (num_origine IS NULL OR num_origine = ''))
     OR (type_facture = 'avoir'
         AND num_origine IS NOT NULL
         AND num_origine != ''
         AND num_origine != num_facture)
),

filtered AS (
  SELECT
    f.*,
    COALESCE(pg.marche, bc.marche)                  AS marche,
    COALESCE(pg.lot_unique, bc.lot_unique)           AS lot_unique,
    COALESCE(pg.organisme, bc.organisme)             AS organisme,
    COALESCE(pg.referent, bc.referent)               AS referent,
    COALESCE(pg.numero_commande, bc.numero_commande) AS numero_commande,
    COALESCE(pg.lot, bc.lot)                         AS lot,
    COALESCE(pg.region, bc.region)                   AS region,
    COALESCE(pg.site, bc.site)                       AS site,
    DATE_TRUNC(f.date_facture, MONTH) AS annee_mois_factu
  FROM factures_base AS f
  LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`int_pilotage_global` AS pg
    ON f.id_benef = pg.id_benef
  LEFT JOIN benef_coll AS bc
    ON f.id_presta_coll = bc.id_presta_coll
)

SELECT
  ai.*,
  p.Montant_prime,
  p.Date_primes
FROM filtered AS ai
LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_prime_compile` p
  ON ai.numero_commande = p.LC
    );
  
