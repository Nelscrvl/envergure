    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_10, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_10,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_11, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_11,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_12, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_12
  FROM `dynamic-camp-465312-b6`.`1_natives`.`ENV_SS_TRAITANCE`
  WHERE temps_action_id IS NOT NULL
),

ref_actions AS (
  SELECT DISTINCT
    codification_action,
    analytique_bu                                  AS bu,
    COALESCE(NULLIF(UPPER(TRIM(famille_prestation)), ''), 'A')  AS famille
  FROM `dynamic-camp-465312-b6`.`1_natives`.`ENV_REF_ACTIONS`
  WHERE codification_action IS NOT NULL
),

ref_marches AS (
  SELECT DISTINCT
    codification_action,
    analytique_bu AS bu
  FROM `dynamic-camp-465312-b6`.`1_natives`.`ENV_REF_MARCHES`
  WHERE codification_action IS NOT NULL
),

unpiv AS (
  SELECT codification_action, 1 AS mois, m_2026_01 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 2 AS mois, m_2026_02 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 3 AS mois, m_2026_03 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 4 AS mois, m_2026_04 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 5 AS mois, m_2026_05 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 6 AS mois, m_2026_06 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 7 AS mois, m_2026_07 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 8 AS mois, m_2026_08 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 9 AS mois, m_2026_09 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 10 AS mois, m_2026_10 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 11 AS mois, m_2026_11 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 12 AS mois, m_2026_12 AS valeur FROM src
  
),

joined AS (
  SELECT
    u.codification_action,
    COALESCE(a.bu, m.bu)                  AS bu,
    COALESCE(a.famille, 'A')               AS famille,
    u.mois,
    u.valeur
  FROM unpiv u
  LEFT JOIN ref_actions a USING (codification_action)
  LEFT JOIN ref_marches m USING (codification_action)
),

agg AS (
  SELECT codification_action, bu, mois, famille, SUM(valeur) AS valeur
  FROM joined
  GROUP BY codification_action, bu, mois, famille
),

expanded AS (
  SELECT
  a.codification_action,
  a.bu,
  a.mois,
  a.famille,
  rm.code_rubrique,
  a.valeur
FROM agg a
INNER JOIN (
