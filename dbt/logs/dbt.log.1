        JSON_VALUE(ContactClient, '$.Nom')  as contact_client_nom,
        JSON_VALUE(ContactClient, '$.ID')   as contact_client_id,
        JSON_VALUE(ContactClient, '$._id')  as contact_client_internal_id,

        Libelle2,

