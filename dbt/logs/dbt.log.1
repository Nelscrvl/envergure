  SELECT 'P' AS scope, 'C611' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
  OR rm.scope = a.famille
)

SELECT * FROM expanded
WHERE NOT (code_rubrique = 'C119' AND famille = 'D')
  AND valeur IS NOT NULL AND valeur != 0
    );
  
