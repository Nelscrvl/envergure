    create or replace table `dynamic-camp-465312-b6`.`2_mart`.`MRT_MS_PROD`
      
    
    

    
    OPTIONS()
    as (
      



WITH unioned AS (
  SELECT codification_action, bu, mois, famille, code_rubrique, valeur FROM `dynamic-camp-465312-b6`.`2_intermediate`.`ENV_MS_PROD`
  UNION ALL
  SELECT codification_action, bu, mois, famille, code_rubrique, valeur FROM `dynamic-camp-465312-b6`.`2_intermediate`.`ESO_MS_PROD`
),

agg AS (
  SELECT
    codification_action,
    bu,
    mois,
    ANY_VALUE(famille) AS famille,
    code_rubrique,
    SUM(valeur)        AS valeur
  FROM unioned
  GROUP BY codification_action, bu, mois, code_rubrique
)

SELECT * FROM agg
WHERE valeur IS NOT NULL AND valeur != 0
    );
  
