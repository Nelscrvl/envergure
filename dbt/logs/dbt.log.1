    create or replace table `dynamic-camp-465312-b6`.`dbt_transfo`.`int_teo`
      
    
    

    OPTIONS()
    as (
      SELECT
*,
"ENVERGURE" AS organisme,
CASE WHEN service_name = "LPR" THEN "LPR",
    WHEN service_name LIKE "Activ%" THEN AP3 
