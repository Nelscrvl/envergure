    create or replace table `dynamic-camp-465312-b6`.`2_intermediate`.`ENV_CA`
      
    
    

    
    OPTIONS()
    as (
      

WITH src AS (
  SELECT
    codification_action,
    analytique_bu                                  AS bu,
    COALESCE(NULLIF(UPPER(TRIM(famille_prestation)), ''), 'A')  AS famille,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_janvier, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_janvier,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_fevrier, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_fevrier,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_mars, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_mars,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_avril, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_avril,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_mai, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_mai,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_juin, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_juin,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_juillet, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_juillet,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_aout, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_aout,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_septembre, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_septembre,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_octobre, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_octobre,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_novembre, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_novembre,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ca_decembre, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ca_decembre
  FROM `dynamic-camp-465312-b6`.`1_natives`.`book_2026`
  WHERE codification_action IS NOT NULL
),

unpiv AS (
  SELECT codification_action, bu, famille, 1 AS mois, ca_janvier AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 2 AS mois, ca_fevrier AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 3 AS mois, ca_mars AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 4 AS mois, ca_avril AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 5 AS mois, ca_mai AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 6 AS mois, ca_juin AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 7 AS mois, ca_juillet AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 8 AS mois, ca_aout AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 9 AS mois, ca_septembre AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 10 AS mois, ca_octobre AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 11 AS mois, ca_novembre AS valeur FROM src
  UNION ALL
  SELECT codification_action, bu, famille, 12 AS mois, ca_decembre AS valeur FROM src
  
),

agg AS (
  SELECT codification_action, bu, mois, famille, SUM(valeur) AS valeur
  FROM unpiv
  GROUP BY codification_action, bu, mois, famille
),

expanded AS (
  SELECT
  a.codification_action,
  a.bu,
  a.mois,
  a.famille,
  rm.code_rubrique,
  a.valeur
FROM agg a
INNER JOIN (
  SELECT 'TOTAL' AS scope, 'C110' AS code_rubrique UNION ALL
  SELECT 'A' AS scope, 'C115' AS code_rubrique UNION ALL
  SELECT 'F' AS scope, 'C116' AS code_rubrique UNION ALL
  SELECT 'P' AS scope, 'C601' AS code_rubrique UNION ALL
  SELECT 'D' AS scope, 'C602' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
  OR rm.scope = a.famille
)

