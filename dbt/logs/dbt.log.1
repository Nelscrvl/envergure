        Type_Tarif.Nombre_Visites                   as tt_nombre_visites,

        -- Type_Tarif → règles de facturation
        Type_Tarif.Facturation                      as tt_facturation,
        Type_Tarif.Facturer_Si_Heures_Planif        as tt_facturer_si_heures_planif,
