[0m14:46:39.924453 [debug] [Thread-1 (]: On model.dbt_envergure.ESO_SS_TRAITANT: /* {"app": "dbt", "dbt_version": "1.9.2", "profile_name": "dbt_envergure", "target_name": "dev", "node_id": "model.dbt_envergure.ESO_SS_TRAITANT"} */

  
    

    create or replace table `dynamic-camp-465312-b6`.`2_intermediate`.`ESO_SS_TRAITANT`
      
    
    

    OPTIONS()
    as (
      



WITH r2026 AS (
  SELECT
    codif_action                       AS codification_action,
    SAFE_CAST(mois AS INT64)           AS mois,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(ss_traitant, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS ss_traitant
  FROM `dynamic-camp-465312-b6`.`1_natives`.`BEN17_R2026`
  WHERE codif_action IS NOT NULL
),

ref_marche AS (
  SELECT
    Codif_action_site                              AS codification_action,
    Code_BU                                        AS bu,
    COALESCE(NULLIF(UPPER(TRIM(Activit__)), ''), 'A')           AS famille
  FROM `dynamic-camp-465312-b6`.`1_natives`.`BEN17_REF_MARCHE`
  WHERE Codif_action_site IS NOT NULL
),

agg AS (
  SELECT
    r.codification_action,
    m.bu,
    r.mois,
    m.famille,
    SUM(r.ss_traitant) AS valeur
  FROM r2026 r
  LEFT JOIN ref_marche m USING (codification_action)
  GROUP BY r.codification_action, m.bu, r.mois, m.famille
),

expanded AS (
  SELECT
  a.codification_action,
  a.bu,
  a.mois,
  a.famille,
  rm.code_rubrique,
  a.valeur
FROM agg a
INNER JOIN (
  SELECT 'TOTAL' AS scope, 'C124' AS code_rubrique UNION ALL
  SELECT 'A' AS scope, 'C125' AS code_rubrique UNION ALL
  SELECT 'F' AS scope, 'C126' AS code_rubrique UNION ALL
  SELECT 'P' AS scope, 'C606' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
  OR rm.scope = a.famille
)

SELECT * FROM expanded
WHERE NOT (code_rubrique = 'C124' AND famille = 'D')
  AND valeur IS NOT NULL AND valeur != 0
    );
  
