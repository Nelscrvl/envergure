  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_pmsmp`
  OPTIONS()
  as WITH new_col AS (

SELECT
*,
1 as nb_pmsmp
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_pmsmp`

)

SELECT
id_benef,
SUM(nb_heures) AS total_nb_heure,
SUM(nb_pmsmp) AS nb_pmsmp
FROM new_col 
GROUP BY id_benef;


