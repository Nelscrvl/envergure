    OPTIONS()
    as (
      

WITH UNION_TABLE AS (
SELECT

*EXCEPT(VALEUR),
-- Anti-doublon : REALISE et BUDGET sont portés par BDD_EDM uniquement (cf. commentaire en-tête).
CASE WHEN TYPE = "REALISE" OR TYPE = "BUDGET" THEN 0
