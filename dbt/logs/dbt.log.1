    create or replace table `dynamic-camp-465312-b6`.`2_intermediate`.`ESO_FDG`
      
    
    

    
    OPTIONS()
    as (
      



WITH r2026 AS (
  SELECT
    codif_action             AS codification_action,
    SAFE_CAST(mois AS INT64) AS mois,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(fdg, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS fdg
  FROM `dynamic-camp-465312-b6`.`1_natives`.`BEN17_R2026`
  WHERE codif_action IS NOT NULL
),

ref_marche AS (
  SELECT
    Codif_action_site                              AS codification_action,
    Code_BU                                        AS bu,
    COALESCE(NULLIF(UPPER(TRIM(Activit__)), ''), 'A')           AS famille
  FROM `dynamic-camp-465312-b6`.`1_natives`.`BEN17_REF_MARCHE`
  WHERE Codif_action_site IS NOT NULL
),

agg AS (
  SELECT
    r.codification_action,
    m.bu,
    r.mois,
    m.famille,
    SUM(r.fdg) AS valeur
  FROM r2026 r
  LEFT JOIN ref_marche m USING (codification_action)
  GROUP BY r.codification_action, m.bu, r.mois, m.famille
),

expanded AS (
  SELECT
  a.codification_action,
  a.bu,
  a.mois,
  a.famille,
  rm.code_rubrique,
  a.valeur
FROM agg a
INNER JOIN (
  SELECT 'TOTAL' AS scope, 'C123' AS code_rubrique UNION ALL
  SELECT 'A' AS scope, 'C603' AS code_rubrique UNION ALL
  SELECT 'F' AS scope, 'C604' AS code_rubrique UNION ALL
  SELECT 'P' AS scope, 'C605' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
  OR rm.scope = a.famille
)

SELECT * FROM expanded
-- C123 (total) exclut famille D (pas de sous-rubrique → assure total = somme breakdown)
WHERE NOT (code_rubrique = 'C123' AND famille = 'D')
  AND valeur IS NOT NULL AND valeur != 0
    );
  
