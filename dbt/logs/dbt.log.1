  SELECT 'A' AS scope, 'C125' AS code_rubrique UNION ALL
  SELECT 'F' AS scope, 'C126' AS code_rubrique UNION ALL
  SELECT 'P' AS scope, 'C606' AS code_rubrique
) rm
  ON rm.scope = 'TOTAL'
  OR rm.scope = a.famille
)

SELECT * FROM expanded
WHERE NOT (code_rubrique = 'C124' AND famille = 'D')
  AND valeur IS NOT NULL AND valeur != 0
    );
  
