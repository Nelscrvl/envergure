        stg.Charge_Affaires as stg_charge_affaires,
        
        -- Coordonnées professionnelles stagiaire (préfixe stg_)
        stg.Email_Pro as stg_email_pro,
        stg.Telephone_Pro as stg_telephone_pro,
        stg.Mobile_Pro as stg_mobile_pro,
        
