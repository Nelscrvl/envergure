    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_06, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_06,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_07, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_07,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_08, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_08,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_09, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_09,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_10, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_10,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_11, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_11,
    SAFE_CAST(REPLACE(REGEXP_REPLACE(m_2026_12, r'[^0-9,.\-]', ''), ',', '.') AS NUMERIC) AS m_2026_12
  FROM `dynamic-camp-465312-b6`.`1_natives`.`ENV_SS_TRAITANCE`
  WHERE temps_action_id IS NOT NULL
),

ref_actions AS (
  SELECT DISTINCT
    codification_action,
    analytique_bu                                  AS bu,
    COALESCE(NULLIF(UPPER(TRIM(famille_prestation)), ''), 'A')  AS famille
  FROM `dynamic-camp-465312-b6`.`1_natives`.`ENV_REF_ACTIONS`
  WHERE codification_action IS NOT NULL
),

ref_marches AS (
  SELECT DISTINCT
    codification_action,
    analytique_bu AS bu
  FROM `dynamic-camp-465312-b6`.`1_natives`.`ENV_REF_MARCHES`
  WHERE codification_action IS NOT NULL
),

unpiv AS (
  SELECT codification_action, 1 AS mois, m_2026_01 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 2 AS mois, m_2026_02 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 3 AS mois, m_2026_03 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 4 AS mois, m_2026_04 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 5 AS mois, m_2026_05 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 6 AS mois, m_2026_06 AS valeur FROM src
  UNION ALL
  SELECT codification_action, 7 AS mois, m_2026_07 AS valeur FROM src
  UNION ALL
