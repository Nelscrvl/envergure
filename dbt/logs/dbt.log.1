        Distanciel,
        Date_Debut,
        Date_Fin,
        Nombre_Stagiaire_Min,
        Nombre_Stagiaire_Max,
        Nombre_Heures_Min,
        Nombre_Heures_Max,
        Ne_Depasse_Pas_Heures,
