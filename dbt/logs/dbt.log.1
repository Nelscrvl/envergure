  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_inscrite_Soc_2`
  OPTIONS()
  as with source as (
    select * from `dynamic-camp-465312-b6`.`Extract_Sofia`.`Inscrite_Soc_2`
),

renamed as (
    SELECT
        -- Colonnes racines
        source.Code_Analytique_Parcours,
