    select
        id_benef,
        id_rdv,
        format_datetime('%Y-%m-%d %H:%M:%S', date_deb) as date_deb,
        format_datetime('%Y-%m-%d %H:%M:%S', date_fin) as date_fin,
        type,
        CASE 
