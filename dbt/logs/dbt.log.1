  SUM(IF(annee_mois_factu = 202612, montant_HT, 0)) AS `Décembre 2026`
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`int_factu_ca`
GROUP BY 1, 2, 3, 4, 5, 6;


