  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_atr_atelier`
  OPTIONS()
  as WITH granu AS 
(
    SELECT
referent,
marche,
region, 
lot_unique AS lot,
site,
organisme,
date_deb,
date_fin,
type_atelier,
theme,
situation,
statut,
