END AS Adhésion,
CASE WHEN order_end_date = "" THEN 1
ELSE 0
END AS abandon,
CASE WHEN order_end_date >= "2021-01-01" THEN 1 
ELSE 0 
END AS fin_de_prestation
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_teo_dossier`
    );
  
