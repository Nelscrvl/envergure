        stg.Mobile_Perso as stg_mobile_perso,
        
        -- Adresse stagiaire (préfixe stg_)
        stg.Adresse.ID as stg_adresse_id,
        stg.Adresse._id as stg_adresse_internal_id,
        stg.Adresse.NumRue as stg_numero_rue,
