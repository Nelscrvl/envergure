),

renamed as (
    SELECT
        -- Colonnes racines
        source.Code_Analytique_Parcours,
        source.Type_Region,
        source.Code_Region,
        source.Libelle_Court_Parcours,
        source.Libelle_Parcours_Groupe,
        source.ID,
