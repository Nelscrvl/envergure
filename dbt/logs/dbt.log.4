        cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Numero_interne') as string) as convention_numero_interne,
        cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Numero_financeur') as string) as convention_numero_financeur,

        -- =========================
        -- Client
        -- =========================
        SAFE_CAST(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Client.ID') as INT64) as client_id,
        cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Client._id') as string) as client_internal_id,
        cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Client.Nom') as string) as client_nom,
        cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Client.Reference') as string) as client_reference,

        -- =========================
        -- Financeur
        -- =========================
        SAFE_CAST(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Financeur.ID') as INT64) as financeur_id,
        cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Financeur._id') as string) as financeur_internal_id,
        cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Financeur.Nom') as string) as financeur_nom,
        cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Financeur.Reference') as string) as financeur_reference,

        -- =========================
        -- Autres champs source
        -- =========================
        cast(to_json_string(Salles) as string) as salles,
        cast(IDLieu as int64) as id_lieu,
        Visibilite_stagiaire  as visibilite_stagiaire,
        cast(Libelle_Action as string) as libelle_action,
        IDAction  as id_action,
        cast(source.Fin as string) as source_fin,
        cast(source.Libelle_Court as string) as source_libelle_court,
        source.Duree  as source_duree,
        cast(source.Libelle_Lieu as string) as source_libelle_lieu,
        cast(source.Libelle as string) as source_libelle,

        -- =========================
        -- Intervenant
        -- =========================
        interv.ID  as intervenant_id,
        cast(interv._id as string) as intervenant_internal_id,
        cast(interv.Reference as string) as intervenant_reference,
        cast(interv.Civilite as string) as intervenant_civilite,
        cast(interv.Nom as string) as intervenant_nom,
        cast(interv.Prenom as string) as intervenant_prenom,
        cast(interv.Signature as string) as intervenant_signature,

        -- =========================
        -- Dates & techniques
        -- =========================
        cast(source.Debut as string) as source_debut,
        IDModule as id_module,
        format_datetime('%Y-%m-%d %H:%M:%S', Date) as date_date,
        source.ID  as source_id,

        -- traçabilité
        'Presence_Soc_3' as source_table

    from source
    cross join unnest(Seances_persos) as seance
    cross join unnest(Intervenants) as interv
)

