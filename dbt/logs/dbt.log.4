catego.*EXCEPT(id_benef),
date_diff(date_facture,date_fin_prest, DAY) AS nb_jour_fin_presta_paiment
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_facture`
FULL JOIN catego
on catego.id_benef = stg_facture.id_benef;


