        present,
        motif_absence,
        theme,
        module,
        dispo_rdv,
        commentaire,
        date_dern_modif,
        util_dern_modif,
        id_util_dern_modif,
        date_crea,
        util_crea,
        id_util_crea,
        mode_rdv,
        signature_envoi,
        signature_benef,
        precision_rdv,
        _extracted_at

    from source

)

select * from renamed;


