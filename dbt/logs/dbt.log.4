  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_formateur_Ca`
  OPTIONS()
  as WITH slct_column AS (
    SELECT
id_benef,
referent,
date_demarrage,
date_fin_prest,
marche,
region, 
lot_unique, 
organisme,
statut,
situation

