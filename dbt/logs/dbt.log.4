  as with source as (
    select * from `dynamic-camp-465312-b6`.`Extract_Sofia`.`Presence_Soc_3`
),
renamed as (
    SELECT
        Materiels,
        
        -- Informations de la séance
        seance.Libelle as seance_libelle,
        seance.Libelle_Court as seance_libelle_court,
        seance._id as seance_internal_id,
        seance.Module_Prevu as module_prevu,
        seance.Type_Seance as type_seance,
        seance.Libelle_Type_Seance as libelle_type_seance,
        seance.Duree as duree,
        seance.Debut as heure_debut,
        seance.Fin as heure_fin_seance,
        seance.Distancielle as distancielle,
        seance.Personnalisee as personnalisee,
        seance.Seance_Action_Principale as seance_action_principale,
        seance.Signature as signature,
        
        -- Informations d'absence
        seance.LTypAbsen as type_absence_libelle,
        seance.IDTypAbsen as type_absence_id,
        seance.Duree_Absence as duree_absence,
        seance.Debut_Absence as debut_absence,
        seance.Fin_Absence as fin_absence,
        
        -- Informations de l'inscription
        seance.Inscrit.ID as inscription_id,
        seance.Inscrit._id as inscription_internal_id,
        seance.Inscrit.Type_Region as type_region,
        seance.Inscrit.Code_Region as code_region,
        seance.Inscrit.Libelle_Parcours as libelle_parcours,
        seance.Inscrit.Libelle_Court_Parcours as libelle_court_parcours,
        seance.Inscrit.Libelle_Parcours_Groupe as libelle_parcours_groupe,
        seance.Inscrit.Libelle_Court_Parcours_Groupe as libelle_court_parcours_groupe,
        seance.Inscrit.Code_Analytique_Parcours as code_analytique_parcours,
        seance.Inscrit.IDParcours_Groupe as id_parcours_groupe,
        CAST(seance.Inscrit.Date_Entree AS DATE) as date_entree,
        CAST(seance.Inscrit.Date_Sortie AS DATE) as date_sortie,
        
        -- Informations du stagiaire
        seance.Inscrit.Stagiaire.ID as stagiaire_id,
        seance.Inscrit.Stagiaire._id as stagiaire_internal_id,
        seance.Inscrit.Stagiaire.ID_Individu as stagiaire_individu_id,
        seance.Inscrit.Stagiaire.Reference as stagiaire_reference,
        seance.Inscrit.Stagiaire.Civilite as stagiaire_civilite,
        seance.Inscrit.Stagiaire.Nom as stagiaire_nom,
        seance.Inscrit.Stagiaire.Prenom as stagiaire_prenom,
        
        -- Informations de la convention (PARSER JSON)
        CAST(JSON_VALUE(seance.Inscrit.Convention, '$.ID') AS INT64) as convention_id,
        CAST(JSON_VALUE(seance.Inscrit.Convention, '$._id') AS INT64) as convention_internal_id,
        CAST(JSON_VALUE(seance.Inscrit.Convention, '$.IDSociete') AS INT64) as convention_id_societe,
        JSON_VALUE(seance.Inscrit.Convention, '$.Libelle') as convention_libelle,
        JSON_VALUE(seance.Inscrit.Convention, '$.Libelle2') as convention_libelle2,
        JSON_VALUE(seance.Inscrit.Convention, '$.Reference') as convention_reference,
        JSON_VALUE(seance.Inscrit.Convention, '$.Numero_interne') as convention_numero_interne,
        JSON_VALUE(seance.Inscrit.Convention, '$.Numero_financeur') as convention_numero_financeur,
        
        -- Informations du client (PARSER JSON)
        CAST(JSON_VALUE(seance.Inscrit.Convention, '$.Client.ID') AS INT64) as client_id,
        CAST(JSON_VALUE(seance.Inscrit.Convention, '$.Client._id') AS INT64) as client_internal_id,
        JSON_VALUE(seance.Inscrit.Convention, '$.Client.Nom') as client_nom,
        JSON_VALUE(seance.Inscrit.Convention, '$.Client.Reference') as client_reference,
        
        -- Informations du financeur (PARSER JSON)
        CAST(JSON_VALUE(seance.Inscrit.Convention, '$.Financeur.ID') AS INT64) as financeur_id,
        CAST(JSON_VALUE(seance.Inscrit.Convention, '$.Financeur._id') AS INT64) as financeur_internal_id,
        JSON_VALUE(seance.Inscrit.Convention, '$.Financeur.Nom') as financeur_nom,
        JSON_VALUE(seance.Inscrit.Convention, '$.Financeur.Reference') as financeur_reference,

        Salles,
        IDLieu,
        Visibilite_stagiaire,
        Libelle_Action,
        IDAction,
        source.Fin,
        source.Libelle_Court,
        source.Duree,
        source.Libelle_Lieu,
        source.Libelle,

        -- Intervenants
        interv.ID as intervenant_id,
        interv._id as intervenant_internal_id,
        interv.Reference as intervenant_reference,
        interv.Civilite as intervenant_civilite,
        interv.Nom as intervenant_nom,
        interv.Prenom as intervenant_prenom,
        interv.Signature as intervenant_signature,
        
        source.Debut,
        IDModule,
        FORMAT_DATETIME('%Y-%m-%d %H:%M:%S', Date) AS date_date,
        source.ID
        
    FROM source,
    UNNEST(Seances_persos) as seance,
    UNNEST(Intervenants) as interv
)
SELECT * FROM renamed;


