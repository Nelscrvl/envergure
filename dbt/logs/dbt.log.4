SELECT
id_benef,
numero_commande,
date_demarrage,
date_fin_prest,
date_fin_theo,
marche,
lot_sans_action,
organisme,
site,
statut,
situation,
referent,
SUM(activite) AS activite,
SUM(adhesion) AS adhesion,
SUM(non_adhere) AS non_adhere,
FROM Cat
