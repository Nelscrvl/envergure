  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_referrent_rdv_ca`
  OPTIONS()
  as -- Étape 1 : compter les RDV par bénéficiaire
WITH nb_rdv AS (
    SELECT
        id_benef,
        COUNT(*) AS nb_rdv
    FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`int_rdv_formateur`
    GROUP BY id_benef
),

-- Étape 2 : diviser le CA par le nombre de RDV
ca_par_rdv AS (
    SELECT
        ca.id_benef,
        ca.date_facture,
        ca.region,
        ca.montant_HT / NULLIF(rdv.nb_rdv, 0) AS CA_HT_par_rdv,
        ca.montant_TVA / NULLIF(rdv.nb_rdv, 0) AS CA_TVA_par_rdv
    FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`int_formateur_Ca` AS ca
    LEFT JOIN nb_rdv AS rdv ON ca.id_benef = rdv.id_benef
),

-- Étape 3 : jointure avec la table RDV
filtrage AS (SELECT
    f.*,
    ca.CA_HT_par_rdv,
    ca.CA_TVA_par_rdv,
    ca.date_facture,
    ca.region,
    TIMESTAMP_DIFF(
             TIMESTAMP(date_fin),
             TIMESTAMP(date_deb),
             MINUTE
           ) AS tps_travail_prevu
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`int_rdv_formateur` AS f
LEFT JOIN ca_par_rdv AS ca ON f.id_benef = ca.id_benef
WHERE f.id_benef <> 0 
  AND DATE(date_deb) <= CURRENT_DATE() 

)

SELECT 

f.*,
tps_travail_ref/60 AS tps_travail_reel_heure,
tps_travail_prevu/60 AS tps_travail_prevu_heure,
row_number() over (
            partition by f.referent, f.id_benef 
            order by f.date_deb asc
        ) as rang_entree,
IF(
    COALESCE(CAST(b.date_fin_prest AS STRING), "") = "",
    NULL,
    ROW_NUMBER() OVER (
        PARTITION BY f.referent, f.id_benef
        ORDER BY b.date_fin_prest ASC
    )
) AS rang_sortie,
b.date_fin_prest

FROM filtrage AS f
LEFT JOIN `dynamic-camp-465312-b6`.`dbt_transfo`.`stg_benef` as b
ON f.id_benef = b.id_benef;


