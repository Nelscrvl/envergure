  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_adv`
  OPTIONS()
  as WITH prep_data AS ( 
    SELECT
id_benef,
nom,
ide,
agence,
conseiller,
referent,
id_ref_principal,
date_demarrage,
date_fin_theo,
date_fin_prest,
split(lot, ' ')[offset(0)] as marche,
lot,
trim(substr(lot, strpos(lot, ' ') + 1)) as lot_sans_action,
