  create or replace view `dynamic-camp-465312-b6`.`dbt_transfo`.`int_formateur_portefeuille`
  OPTIONS()
  as SELECT 
    referent,
    marche,
    region,
    lot_unique,
    COUNT(*) AS candidats_en_portefeuille
FROM `dynamic-camp-465312-b6`.`dbt_transfo`.`int_pilotage`
WHERE date_demarrage <= CURRENT_DATE
  AND (date_fin_prest IS NULL OR date_fin_prest >= CURRENT_DATE)
GROUP BY referent, marche, region, lot_unique;


