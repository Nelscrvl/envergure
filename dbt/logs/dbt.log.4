-- =========================
SAFE_CAST(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Client.ID') as INT64) as client_id,
cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Client._id') as string) as client_internal_id,  -- STRING pas INT64
cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Client.Nom') as string) as client_nom,
cast(JSON_EXTRACT_SCALAR(seance.Inscrit.Convention, '$.Client.Reference') as string) as client_reference,

