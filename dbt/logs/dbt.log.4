marche,
lot,
organisme,
tps_travail_ref
FROM granularite
GROUP BY date_deb,
id_benef,
date_fin,
type,
typage,
referent,
id_referent,
site,
id_site,
presence,
marche,
lot,
lot_sans_action,
organisme,
tps_travail_ref;


